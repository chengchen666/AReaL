@@ -185,6 +185,9 @@ class GenerateRequest(BaseModel):
             raise ValueError("content_parts and features are mutually exclusive")
         return self
 
+    expected_token_ids: list[int] | None = None
+    """AReaL extension: the fully rendered prompt token IDs to assert."""
+
     @model_validator(mode="after")
     def _require_ec_for_metadata_only(self) -> "GenerateRequest":
